# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct PostgreSQL Connection for Drizzle ORM
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.your-project.supabase.co:5432/postgres

# Agent Autopilot Speed (milliseconds between simulation cycles, default 3000)
NEXT_PUBLIC_AGENT_CYCLE_MS=3000
